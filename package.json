{
  "name": "vibi-yt",
  "version": "0.2.0",
  "description": "Read-only YouTube capabilities for coding agents: search, video details, transcripts, and your subscriptions, as Pi tools and user commands.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "author": "fookhsu",
  "keywords": [
    "pi-package",
    "pi",
    "youtube",
    "agent-skill",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fookhsu/vibi-yt.git"
  },
  "bugs": {
    "url": "https://github.com/fookhsu/vibi-yt/issues"
  },
  "homepage": "https://github.com/fookhsu/vibi-yt#readme",
  "files": [
    "extensions/",
    "lib/",
    "tools/",
    "adapters/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "ci": "npm run typecheck && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "youtube-transcript-plus": "^2.0.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.20.2",
    "typebox": "^1.3.30",
    "typescript": "^7.0.2"
  }
}
