{
  "name": "vibi-yt",
  "version": "0.1.4",
  "description": "YouTube search, video metadata, and transcripts as a Pi extension, an MCP server, or portable tool definitions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "fookhsu",
  "keywords": [
    "pi-package",
    "pi",
    "youtube",
    "agent-skill",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fookhsu/vibi-yt.git"
  },
  "bugs": {
    "url": "https://github.com/fookhsu/vibi-yt/issues"
  },
  "homepage": "https://github.com/fookhsu/vibi-yt#readme",
  "files": [
    "dist/",
    "extensions/",
    "adapters/",
    "tools/",
    "lib/",
    "bin/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/tools/index.js",
  "types": "./dist/tools/index.d.ts",
  "bin": {
    "vibi-mcp": "./bin/mcp.mjs"
  },
  "exports": {
    ".": "./dist/tools/index.js",
    "./tools": "./dist/tools/index.js",
    "./adapters/portable": "./dist/adapters/portable.js",
    "./adapters/mcp": "./dist/adapters/mcp/server.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "mcp": "npm run build && node ./bin/mcp.mjs",
    "ci": "npm run typecheck && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "version:check": "node scripts/check-version-bump.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "typebox": "^1.3.7",
    "youtube-transcript-plus": "^1.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/node": "^26.1.0",
    "typescript": "^7.0.2"
  }
}
